# Server
PORT=5000
NODE_ENV=development

# Database — o'zingizning ulanish satringizni qo'ying (bu yerga HAQIQIY parol yozmang!)
MONGODB_URI=mongodb://localhost:27017/atelix

# JWT — ishlab chiqarishda albatta uzun, tasodifiy qiymatga almashtiring
# Masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=30d

# CORS — frontend manzili (bir nechta bo'lsa vergul bilan)
CLIENT_URL=http://localhost:3000
